---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="博客">
  <h1>博客</h1>
  <p class="dim">共 {posts.length} 篇 · 记录学习与技术思考。</p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>
            <div class="meta">
              <FormattedDate date={post.data.pubDate} />
              <span class="tags">
                {post.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
  }
  .dim {
    color: var(--text-dim);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }
  .post-list li {
    border-bottom: 1px solid var(--border);
    padding: 1.2rem 0;
  }
  .post-list a {
    color: var(--text);
  }
  .post-list a:hover {
    text-decoration: none;
  }
  .post-list a:hover h2 {
    color: var(--accent);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 0.3rem;
  }
  .post-list h2 {
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
  }
  .post-list p {
    margin: 0;
    color: var(--text-dim);
  }
</style>
