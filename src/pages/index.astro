---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';

const skills = [
  'Python',
  'JavaScript / TypeScript',
  'C / C++',
  '数据结构与算法',
  'Web 开发 (HTML/CSS)',
  'Git & GitHub',
];

const highlights = [
  {
    href: '/blog',
    title: '📝 技术博客',
    body: '记录学习笔记、踩坑记录与项目复盘，用写作倒逼输入。',
  },
  {
    href: '/projects',
    title: '🚀 项目作品',
    body: '把课程作业和业余小项目整理成可演示的作品集。',
  },
  {
    href: '/about',
    title: '👤 关于我',
    body: '计算机专业在读，热爱把想法变成能跑的代码。',
  },
];
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <h1>你好，我是 {AUTHOR_NAME} 👋</h1>
    <p class="lead">
      一名计算机专业学生，正在这个站点里沉淀我的<strong>代码、思考与作品</strong>。
      这里没有花哨的营销话术，只有实打实的学习与构建。
    </p>
    <div class="cta">
      <a class="btn" href="/blog">读博客</a>
      <a class="btn ghost" href="/projects">看项目</a>
    </div>
  </section>

  <section class="skills">
    <h2>技能栈</h2>
    <div class="chips">
      {skills.map((s) => <span class="chip">{s}</span>)}
    </div>
  </section>

  <section>
    <h2>从这里开始</h2>
    <div class="grid">
      {highlights.map((h) => <Card {...h} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 1.5rem;
  }
  .hero h1 {
    font-size: 2.4rem;
    margin-bottom: 0.8rem;
  }
  .lead {
    color: var(--text-dim);
    font-size: 1.1rem;
    max-width: 38rem;
  }
  .cta {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
  }
  .btn {
    background: var(--accent);
    color: #0d1117;
    font-weight: 700;
    padding: 0.55rem 1.2rem;
    border-radius: 8px;
  }
  .btn:hover {
    text-decoration: none;
    filter: brightness(1.08);
  }
  .btn.ghost {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .skills {
    margin-top: 2.5rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.9rem;
  }
  h2 {
    font-size: 1.4rem;
    margin: 2rem 0 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
</style>
