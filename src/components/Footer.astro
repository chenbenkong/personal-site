---
import { SITE_TITLE, AUTHOR_NAME, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} {AUTHOR_NAME} · {SITE_TITLE}</p>
    <p class="links">
      {SOCIAL.github && <a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>}
      {SOCIAL.email && <a href={`mailto:${SOCIAL.email}`}>Email</a>}
      {SOCIAL.blog && <a href={SOCIAL.blog} target="_blank" rel="noopener">Blog</a>}
      <a href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding: 2rem 0;
    color: var(--text-dim);
    font-size: 0.9rem;
    text-align: center;
  }
  .links a {
    margin: 0 0.5rem;
  }
</style>
