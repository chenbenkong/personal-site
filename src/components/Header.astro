---
const nav = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">{"</>"} Benkong</a>
    <nav>
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={path === item.href ? 'active' : ''}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(13, 17, 23, 0.8);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    color: var(--text);
    font-weight: 700;
    font-family: var(--mono);
  }
  nav a {
    color: var(--text-dim);
    margin-left: 1.2rem;
    font-size: 0.95rem;
  }
  nav a:hover,
  nav a.active {
    color: var(--accent);
    text-decoration: none;
  }
</style>
